# Monarch Property Management - Production Environment Configuration
# ============================================================================
# IMPORTANT: Never commit this file with real values to version control
# Use a secure secrets manager (Supabase Vault, AWS Secrets Manager, etc.)
# ============================================================================

# Supabase Configuration
VITE_SUPABASE_URL=https://yhegaaqxmuhszesbjtdo.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=[REDACTED]

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_TRACKING=true
VITE_LOG_LEVEL=error
VITE_ENABLE_PERFORMANCE_MONITORING=true

# External Services
VITE_STRIPE_PUBLISHABLE_KEY=[REDACTED]

# API Configuration
VITE_API_TIMEOUT=30000
VITE_MAX_RETRIES=3

# Security
VITE_CSRF_ENABLED=true
VITE_RATE_LIMIT_ENABLED=true

# Build Configuration
VITE_BUILD_VERSION=1.0.0
VITE_BUILD_ENV=production
NODE_ENV=production

# Performance Optimization
VITE_ENABLE_CODE_SPLITTING=true
VITE_ENABLE_COMPRESSION=true
VITE_ENABLE_CACHING=true

# Monitoring & Observability
# VITE_SENTRY_DSN=[REDACTED]
# VITE_SENTRY_ENVIRONMENT=production
# VITE_LOGROCKET_APP_ID=[REDACTED]

# Feature Gates (Production Toggles)
VITE_ENABLE_VENDOR_ONBOARDING=true
VITE_ENABLE_PAYMENT_PROCESSING=true
VITE_ENABLE_CONTRACT_SIGNING=true
VITE_ENABLE_RFQ_SYSTEM=true
VITE_ENABLE_DOCUMENT_UPLOAD=true

# Business Configuration
VITE_DEFAULT_CURRENCY=USD
VITE_TIMEZONE=America/New_York
VITE_LOCALE=en-US

# Rate Limiting
VITE_MAX_UPLOAD_SIZE_MB=50
VITE_MAX_REQUESTS_PER_MINUTE=100

# Session Management
VITE_SESSION_TIMEOUT_MINUTES=60
VITE_IDLE_TIMEOUT_MINUTES=30
